{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "hostname": "127.0.0.1",
            "pathMappings": {
                "${workspaceFolder}": "${workspaceFolder}"
            },
            "log": false,
            "xdebugSettings": {
                "max_data": -1,
                "max_depth": -1,
                "max_children": -1
            }
        },
        {
            "name": "Xdebug: Current Script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "port": 9003,
            "runtimeExecutable": "${workspaceFolder}/../php/php.exe",
            "runtimeArgs": ["-c", "${workspaceFolder}/../php/php.ini"]
        }
    ]
}
